      "mia",
      "Der Nebel lässt mich nicht durch. Davor steht Eule Olga – vielleicht kann sie helfen."
    ],
    "tor.hello.missing": [
      "eule",
      "Hu-hu! Hinter dem Nebel liegt die nächste Welt. Zuerst brauchst du alle Abzeichen dieser Welt. Dir fehlen noch {n}: {names}."
    ],
    "tor.hello.ready": [
      "eule",
      "Hu-hu! Du hast alle Abzeichen! Dann kommt jetzt meine kleine Mathearbeit: fünf Aufgaben, eine aus jedem Spiel. Mit vier richtigen bestehst du. Ein Fehler ist erlaubt!"
    ],
    "tor.hello.passed": [
      "eule",
      "Du hast meine Mathearbeit bestanden. Der Nebel ist weg, geh nur weiter!"
    ],
    "tor.hello.last": [
      "eule",
      "Du hast meine Mathearbeit bestanden! Hinter dem Nebel wächst noch alles heran, die nächste Welt kommt bald."
    ],
    "exam.intro": [
      "eule",
      "Los geht's! Fünf Aufgaben, eine aus jedem Spiel. Denk in Ruhe nach, es gibt keinen Zeitdruck."
    ],
    "exam.pass.5": [
      "eule",
      "Alle fünf richtig! Das war eine Eins mit Sternchen. Der Nebel lichtet sich!"
    ],
    "exam.pass.4": [
      "eule",
      "Vier von fünf, das reicht! Bestanden. Der Nebel lichtet sich!"
    ],
    "exam.fail": [
      "eule",
      "Das war noch nicht ganz genug, aber das ist nicht schlimm. Übe noch ein bisschen bei deinen Freunden und komm wieder. Du darfst es so oft versuchen, wie du magst."
    ],
    "exam.open": [
      "mia",
      "Der Nebel lichtet sich! Auf in die nächste Welt!"
    ],
    "exam.reihe.prompt": [
      "eule",
      "Setze die Reihe fort: {seq}, … Welche Zahl kommt als Nächstes?"
    ],
    "exam.choice.prompt": [
      "eule",
      "Wie viel ist {a} mal {b}? Tippe die richtige Zahl an."
    ],
    "exam.reihe.hint": [
      "eule",
      "Schau, um wie viel die Zahlen jedes Mal größer werden, und zähle genauso weiter."
    ],
    "exam.choice.hint": [
